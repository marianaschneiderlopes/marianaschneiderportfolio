{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/central", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ],
  "rewrites": [
    { "source": "/:slug((?!api$|central$|more-work$|index$|img$|files$)[a-zA-Z0-9-]+)", "destination": "/" }
  ]
}
